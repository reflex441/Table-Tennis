# ---------------------------------------------------------------------------
# TT Alarms - environment variables
# Copy to .env and fill in. Never commit .env. All of these are server-only.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (required)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/table_tennis?schema=public"

# Google Gemini API key from https://aistudio.google.com/apikey (required for screenshot scanning)
GEMINI_API_KEY=""
# The Gemini model and backup model are chosen in the app: Settings → Gemini API
# (default gemini-3.5-flash-lite, backup gemini-3.8-flash).
# Optional: override the Gemini API base URL (API gateway/proxy). Leave empty normally.
GEMINI_BASE_URL=""

# Web Push VAPID keys (required for background push notifications).
# Generate with: npm run vapid
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact for push services: mailto: address or https URL
VAPID_SUBJECT="mailto:you@example.com"

# Scheduler mode:
#   inprocess - the Next.js server runs the alarm loop (single long-running server; default)
#   worker    - run `npm run worker` as a separate process (recommended for Docker/VPS)
#   external  - serverless (e.g. Vercel): a cron service calls /api/cron/dispatch every minute
SCHEDULER_MODE="inprocess"
# Poll interval for inprocess/worker modes (ms). The loop also wakes exactly when the next alarm is due.
SCHEDULER_INTERVAL_MS="10000"

# Shared secret for /api/cron/dispatch (send as "Authorization: Bearer <secret>").
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# Optional single-user password. When set, every page and API needs a login.
# Strongly recommended for any internet-facing deployment.
APP_PASSWORD=""
# Secret for signing login cookies (32+ random characters). Generate with: openssl rand -hex 32
SESSION_SECRET=""
