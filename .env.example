# ---------------------------------------------------------------------------
# TT Alarms - environment variables
# Copy to .env and fill in. Never commit .env. All of these are server-only.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (required)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/table_tennis?schema=public"
# Optional: separate connection for migrations. On Supabase + Vercel, DATABASE_URL is the
# Transaction pooler (port 6543) and DIRECT_URL the Session pooler (port 5432).
DIRECT_URL=""

# Gemini API keys are entered by each user in the app (Settings → Gemini API), not here.
# The Gemini model and backup model are chosen in the app: Settings → Gemini API
# (default gemini-3.5-flash-lite, backup gemini-3.8-flash).
# Optional: override the Gemini API base URL (API gateway/proxy). Leave empty normally.
GEMINI_BASE_URL=""

# Web Push VAPID keys (required for background push notifications).
# Generate with: npm run vapid
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact for push services: mailto: address or https URL
VAPID_SUBJECT="mailto:you@example.com"

# Scheduler mode:
#   inprocess - the Next.js server runs the alarm loop (single long-running server; default)
#   worker    - run `npm run worker` as a separate process (recommended for Docker/VPS)
#   external  - serverless (e.g. Vercel): a cron service calls /api/cron/dispatch every minute
SCHEDULER_MODE="inprocess"
# Poll interval for inprocess/worker modes (ms). The loop also wakes exactly when the next alarm is due.
SCHEDULER_INTERVAL_MS="10000"

# Shared secret for /api/cron/dispatch (send as "Authorization: Bearer <secret>").
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# Accounts: everyone must sign up / sign in. Each account has its own matches, bets, settings
# and Gemini API key (entered in Settings).
# Optional: secret for signing login cookies (32+ random characters, openssl rand -hex 32).
# If empty, a random secret is generated once and stored in the database.
SESSION_SECRET=""

# Optional "Continue with Google" sign-in. Create an OAuth client (type "Web application") at
# https://console.cloud.google.com/apis/credentials and add this Authorized redirect URI:
#   <APP_URL>/api/auth/google/callback     e.g. http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Public URL of the app (no trailing slash). Needed for Google sign-in behind a proxy / custom domain.
APP_URL=""

# Leaderboard: the ROI ranking needs 100 settled bets (the units ranking has no minimum).
# Emails listed here (comma-separated) are ranked by ROI regardless, e.g. your own. Emails are never shown.
LEADERBOARD_ALWAYS_SHOW=""

# Tailing: every account automatically tails one account and can copy its bets.
# Defaults to the first account created; set an email here to choose another.
TAILING_ACCOUNT_EMAIL=""
