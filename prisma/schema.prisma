// Prisma schema for the Table Tennis match reminder application.
// All timestamps are stored as UTC (`timestamptz`). Display timezones are
// applied in the UI using the user's preferred IANA timezone.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ScreenshotStatus {
  UPLOADED
  PROCESSING
  EXTRACTED
  FAILED
}

/// Where the screenshot capture time came from. Only EXIF and MANUAL are
/// treated as reliable when resolving relative times ("Today", "in 45 min").
enum CaptureTimeSource {
  EXIF
  FILE_MODIFIED
  MANUAL
  NONE
}

enum Selection {
  OVER
  UNDER
}

enum AlarmStatus {
  SCHEDULED
  SENDING
  TRIGGERED
  COMPLETED
  CANCELLED
  FAILED
}

enum DeliveryChannel {
  PUSH
  IN_APP
}

enum DeliveryStatus {
  SENT
  FAILED
}

/// BOT = the screenshot showed a pick badge (e.g. "1U OVER (12/17, 71%)"); PERSONAL = your own play.
enum PlayType {
  BOT
  PERSONAL
}

enum BetResult {
  PENDING
  WON
  LOST
  VOID
}

/// An uploaded screenshot. Image bytes are stored in Postgres so the app
/// has no extra storage dependency (files are capped at 8 MB).
model Screenshot {
  id               String            @id @default(cuid())
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
  filename         String
  mimeType         String
  sizeBytes        Int
  sha256           String
  data             Bytes
  capturedAt       DateTime?         @db.Timestamptz(3)
  capturedAtSource CaptureTimeSource @default(NONE)
  status           ScreenshotStatus  @default(UPLOADED)
  error            String?

  extractions Extraction[]
  sources     MatchSource[]

  @@index([sha256])
  @@index([createdAt])
}

/// The raw and validated output of one Gemini run over a screenshot.
model Extraction {
  id           String     @id @default(cuid())
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  screenshotId String
  screenshot   Screenshot @relation(fields: [screenshotId], references: [id], onDelete: Cascade)
  model        String
  durationMs   Int
  /// Unmodified JSON returned by Gemini (for auditing / debugging).
  rawResponse  Json
  /// Server-validated result (invalid values replaced by null + warning).
  result       Json
  warnings     String[]

  @@index([screenshotId, createdAt])
}

model Match {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  player1     String
  player2     String
  competition String?
  /// Confirmed match start, UTC.
  startsAt    DateTime @db.Timestamptz(3)
  /// IANA timezone the user confirmed the time in (for display/auditing).
  timezone    String
  /// Verbatim time text from the screenshot, if any (e.g. "Today at 6:00 PM").
  rawTimeText String?
  notes       String?
  /// Normalised "player-a|player-b|startMinute" key used to prevent duplicates.
  dedupeKey   String   @unique
  playType    PlayType @default(PERSONAL)
  /// Stake in units shown on the pick badge ("1U"), if any.
  stakeUnits  Float?

  statistics MatchStatistics?
  alarm      Alarm?
  sources    MatchSource[]
  bet        Bet?

  @@index([startsAt])
}

/// Selection and statistics attached to a match. Every field is optional:
/// screenshots frequently contain only part of the information.
model MatchStatistics {
  id         String     @id @default(cuid())
  matchId    String     @unique
  match      Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  selection  Selection?
  pointsLine Float?
  /// O/U record exactly as shown, e.g. "20/9".
  ouStats    String?
  /// O/U hit rate percentage, 0-100.
  ouHitRate  Float?
  /// EDGE percentage, -100..100.
  edge       Float?
}

/// Join table: which screenshots contributed to a match.
model MatchSource {
  matchId      String
  screenshotId String
  match        Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  screenshot   Screenshot @relation(fields: [screenshotId], references: [id], onDelete: Cascade)

  @@id([matchId, screenshotId])
}

/// One reminder per match. `generation` increments whenever the alarm is
/// rescheduled so that delivery de-duplication applies per schedule.
model Alarm {
  id              String      @id @default(cuid())
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(3)
  matchId         String      @unique
  match           Match       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  reminderMinutes Int
  /// When the notification should fire (startsAt - reminderMinutes), UTC.
  fireAt          DateTime    @db.Timestamptz(3)
  /// When the dispatcher should next process the alarm (fireAt, or a retry time).
  nextAttemptAt   DateTime    @db.Timestamptz(3)
  status          AlarmStatus @default(SCHEDULED)
  generation      Int         @default(1)
  attempts        Int         @default(0)
  lockedAt        DateTime?   @db.Timestamptz(3)
  lastError       String?
  triggeredAt     DateTime?   @db.Timestamptz(3)
  completedAt     DateTime?   @db.Timestamptz(3)
  cancelledAt     DateTime?   @db.Timestamptz(3)
  /// When the user confirmed the alarm ("bet placed" / "skipped"); stops ringing.
  ackAt           DateTime?   @db.Timestamptz(3)
  /// "placed" or "skipped".
  ackAction       String?
  /// Next time the push notification is repeated while the alarm rings.
  nextRepeatAt    DateTime?   @db.Timestamptz(3)
  repeatCount     Int         @default(0)

  deliveries    NotificationDelivery[]
  notifications InAppNotification[]

  @@index([status, nextAttemptAt])
  @@index([status, nextRepeatAt])
}

/// A bet actually placed on a match (created by "I've placed the bet").
model Bet {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  matchId   String    @unique
  match     Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  /// Units staked (1 unit = Settings.unitSize in money).
  stake     Float
  /// Decimal odds, e.g. 1.85. Needed to compute profit for a win.
  odds      Float?
  result    BetResult @default(PENDING)
  /// Profit in units, stored for sorting/aggregation: WON stake*(odds-1), LOST -stake, VOID 0.
  profit    Float?
  placedAt  DateTime  @default(now()) @db.Timestamptz(3)
  settledAt DateTime? @db.Timestamptz(3)

  @@index([result])
}

model PushSubscription {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  endpoint      String    @unique
  p256dh        String
  auth          String
  /// "desktop" rings until the bet is confirmed; "mobile" gets one normal notification.
  deviceType    String    @default("desktop")
  userAgent     String?
  active        Boolean   @default(true)
  failureCount  Int       @default(0)
  lastSuccessAt DateTime? @db.Timestamptz(3)
  lastFailureAt DateTime? @db.Timestamptz(3)
  lastError     String?

  deliveries NotificationDelivery[]
}

/// Log of every delivery attempt. The unique constraint guarantees a given
/// alarm schedule (generation) is pushed at most once per subscription.
model NotificationDelivery {
  id             String           @id @default(cuid())
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  alarmId        String
  alarm          Alarm            @relation(fields: [alarmId], references: [id], onDelete: Cascade)
  generation     Int
  channel        DeliveryChannel  @default(PUSH)
  subscriptionId String
  subscription   PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  status         DeliveryStatus
  error          String?
  attempts       Int              @default(1)

  @@unique([alarmId, generation, subscriptionId])
}

/// Notifications shown inside the app (toast + notification centre).
model InAppNotification {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  alarmId    String?
  alarm      Alarm?    @relation(fields: [alarmId], references: [id], onDelete: Cascade)
  generation Int?
  matchId    String?
  title      String
  body       String
  url        String
  readAt     DateTime? @db.Timestamptz(3)

  @@unique([alarmId, generation])
  @@index([createdAt])
}

/// Single-row application settings (id is always 1).
model Settings {
  id                         Int      @id @default(1)
  updatedAt                  DateTime @updatedAt @db.Timestamptz(3)
  defaultReminderMinutes     Int      @default(5)
  timezone                   String   @default("Australia/Sydney")
  /// Defaults to NSW (confirmed). Set to false to make extracted times always need confirmation.
  timezoneConfirmed          Boolean  @default(true)
  /// Preferred interpretation of ambiguous numeric dates like 03/04/2026.
  dateOrder                  String   @default("DMY")
  pushEnabled                Boolean  @default(true)
  inAppEnabled               Boolean  @default(true)
  soundEnabled               Boolean  @default(true)
  includeStatsInNotification Boolean  @default(true)
  /// Screenshots list today's matches: bare times are today (or tomorrow after midnight).
  screenshotsAreToday        Boolean  @default(true)
  /// Times in screenshots are in `timezone`; timezone labels read from images are ignored.
  screenshotTimesAreLocal    Boolean  @default(true)
  /// Keep alerting (in-app siren + repeated push) until the user confirms the bet.
  ringUntilAck               Boolean  @default(true)
  /// Seconds between repeated push notifications while an alarm rings.
  repeatSeconds              Int      @default(30)
  /// Money per unit (a "1U" bot play stakes this amount).
  unitSize                   Float    @default(10)
  /// Currency symbol shown next to stakes and profit.
  currency                   String   @default("$")
  /// When on, every bet's profit uses averageOdds instead of the bet's own odds.
  useAverageOdds             Boolean  @default(false)
  averageOdds                Float    @default(1.85)
  /// Gemini model for scanning (overrides GEMINI_MODEL).
  geminiModel                String   @default("gemini-3.5-flash-lite")
  /// Comma-separated backup models; empty turns the backup off.
  geminiFallbackModel        String   @default("gemini-3.8-flash")
  /// Gemini API key entered in Settings. Never returned to the browser;
  /// takes precedence over the GEMINI_API_KEY environment variable.
  geminiApiKey               String?
}
